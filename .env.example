# ── SENHA DO PAINEL (obrigatório) ──
# Sem isso o painel fica sem proteção em produção.
PANEL_PASS=troque_esta_senha
# PANEL_SECRET=uma_frase_aleatoria_longa   # opcional, reforça a assinatura do cookie

# ── LOG ──
LOG_LEVEL=info        # error | warn | info | debug
# COOKIE_SECURE=1      # 1 se estiver atrás de HTTPS (Render já é)

# ── PERSISTÊNCIA EXTERNA (opcional, recomendado no Render free) ──
# Crie um banco grátis em https://console.upstash.com → Redis → REST API
# e cole as duas linhas abaixo. Assim os dados sobrevivem a restart/deploy.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
# KV_PREFIX=btd:

# ── ROBLOX ──
ROBLOX_API_KEY=sua_chave_aqui
ROBLOX_COOKIE=seu_cookie_.ROBLOSECURITY_aqui
ROBLOX_GROUP_ID=190007685
PORT=3000
# WhatsApp (CallMeBot, grátis): 1 chave POR número, na mesma ordem.
# Ex: WA_PHONE=5511999998888,5521988887777
#     WA_APIKEY=chave_do_primeiro,chave_do_segundo
WA_PHONE=
WA_APIKEY=
# IA gratuita (sem chave): respostas livres via Pollinations. Para ligar: AI_PROVIDER=pollinations
AI_PROVIDER=
# IA OpenAI (opcional, paga): OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
# Bot do Discord (comandos + aviso de venda no canal + aviso de IP)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
